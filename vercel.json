{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "redirects": [
    {
      "source": "/app/calculator",
      "destination": "/bench",
      "statusCode": 301
    },
    {
      "source": "/app/batches",
      "destination": "/bench/journal",
      "statusCode": 301
    },
    {
      "source": "/guides",
      "destination": "/library",
      "statusCode": 301
    },
    {
      "source": "/guides/:slug",
      "destination": "/library/:slug",
      "statusCode": 301
    },
    {
      "source": "/ar/guides",
      "destination": "/ar/library",
      "statusCode": 301
    },
    {
      "source": "/ar/guides/:slug",
      "destination": "/ar/library/:slug",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/recipe?slug=:slug&lang=en"
    },
    {
      "source": "/ar/r/:slug",
      "destination": "/api/recipe?slug=:slug&lang=ar"
    },
    {
      "source": "/sitemap-recipes.xml",
      "destination": "/api/recipe?sitemap=1"
    },
    {
      "source": "/bench",
      "destination": "/app/index.html"
    },
    {
      "source": "/bench/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/wardrobe",
      "destination": "/app/index.html"
    },
    {
      "source": "/wardrobe/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/atlas",
      "destination": "/app/index.html"
    },
    {
      "source": "/atlas/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/salon",
      "destination": "/app/index.html"
    },
    {
      "source": "/salon/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/nose",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/r-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
