{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/lib/calc/**/*.ts", "src/lib/formulation.ts", "src/lib/selector/**/*.ts", "src/lib/benchData.ts", "src/lib/database.types.ts"],
  "exclude": ["src/**/*.test.ts"]
}
