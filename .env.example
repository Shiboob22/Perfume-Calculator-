# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API).
#
# IMPORTANT: use the "anon" / "public" key here, NOT the service_role
# key from the FastAPI scraper backend's .env — this file ships to the
# browser, so it must only ever hold a key that's safe to expose.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini AI (free tier) — server-only. Get a key at
# https://aistudio.google.com/apikey and add it in Vercel → Settings →
# Environment Variables. Do NOT prefix with VITE_: that would ship the key
# to every visitor's browser.
GEMINI_API_KEY=
# Optional: override the default model (gemini-3.8-flash).
# GEMINI_MODEL=

# Kill switch for stock on log (Phase 8). Unset: POST /api/batches takes a
# Pro user's oil out of stock as it logs the batch. "client": the server
# leaves stock alone and the app deducts the old way (PATCH /api/inventory).
# STOCK_ON_LOG=client

# CORS: the API answers browsers only from the origins listed in
# api/_lib/http.ts (the production aliases). Add a custom domain there.
